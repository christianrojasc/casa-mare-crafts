  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Casa Mare pairs Playfair Display (boutique serif, default) with Inter (clean body). If Cormorant Garamond is available in your Shopify font library, swap it in via the Heading font picker below — both fit the brand kit."
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "playfair_display_n5"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 90,
        "max": 140,
        "step": 5,
        "default": 110,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body size scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "default": 100,
        "unit": "%"
      },
      {
        "type": "checkbox",
        "id": "uppercase_nav",
        "label": "Uppercase letterspaced nav/labels",
        "default": true
