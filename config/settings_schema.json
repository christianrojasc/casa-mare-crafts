        "min": 40,
        "max": 160,
        "step": 4,
        "default": 104,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Primary button style",
        "options": [
          { "value": "navy_solid", "label": "Solid navy" },
          { "value": "navy_outline", "label": "Navy outline" }
        ],
        "default": "navy_solid"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
