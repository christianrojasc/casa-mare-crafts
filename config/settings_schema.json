  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Primary logo (light background)",
        "info": "Use logo-primary.png or logo-wordmark.png. Leave empty to fall back to the bundled primary logo."
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Inverse logo (for navy footer)",
        "info": "Optional — a white version. If empty, the primary logo is tinted white."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (px)",
        "min": 100,
        "max": 320,
        "step": 10,
        "default": 180,
        "unit": "px"
      }
    ]
  },
