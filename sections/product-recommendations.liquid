<section class="section section--tight" data-product-recommendations data-product-id="{{ product.id }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
  <div class="page-width">
    {%- if recommendations.products.size > 0 -%}
      <div class="t-eyebrow text-center" style="margin-bottom: 12px;">{{ section.settings.eyebrow }}</div>
      <h2 class="t-h2 text-center">{{ section.settings.heading }}</h2>
      <div class="wave-divider" aria-hidden="true">
        <svg viewBox="0 0 64 14" preserveAspectRatio="none"><path d="M0 7 C 10 0, 22 14, 32 7 S 54 0, 64 7"/></svg>
      </div>
      <div class="grid grid--4" style="margin-top: 40px;">
        {%- for p in recommendations.products limit: 4 -%}
          {% render 'product-card', product: p %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You may also love" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces with the same calm" }
  ]
}
{% endschema %}
