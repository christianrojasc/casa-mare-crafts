<section class="section{% if section.settings.dark %} section--dark{% elsif section.settings.sand %} section--sand{% endif %}">
  <div class="page-width">
    <div class="grid" style="grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(24px, 5vw, 80px);">
      <div style="{% if section.settings.image_first %}order: 0{% else %}order: 1{% endif %}">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}"
               alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
               loading="lazy"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               style="width: 100%; height: auto; border-radius: 2px; box-shadow: var(--shadow-soft);">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="t-eyebrow" style="margin-bottom: 14px;">{% render 'i18n-default', value: section.settings.eyebrow, key: 'homepage.story.eyebrow', default: 'Our story' %}</div>
        {%- endif -%}
        {%- if section.settings.script_line != blank -%}
          <div class="t-script" style="font-size: 1.6rem; margin-bottom: 14px;">{% render 'i18n-default', value: section.settings.script_line, key: 'homepage.story.script', default: 'Slow living, by the sea' %}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="t-h2">{% render 'i18n-default', value: section.settings.heading, key: 'homepage.story.heading', default: 'Made for homes that feel lived-in' %}</h2>
        {%- endif -%}
        <div class="stack" style="margin-top: 22px; max-width: 54ch;">
          {% render 'i18n-default', value: section.settings.body, key: 'homepage.story.body', default: '<p>Casa Mare Crafts was created for homes that feel relaxed, warm, and personal. Each piece is inspired by coastal living, natural materials, and the quiet beauty of handmade details.</p><p>Our pieces are designed to make your home feel collected, sun-warmed, and lived-in — never overly polished, never mass-produced.</p>' %}
        </div>
        {%- if section.settings.cta_label != blank -%}
          <div style="margin-top: 32px;">
            <a href="{{ section.settings.cta_link }}" class="btn {% if section.settings.dark %}btn--outline-light{% else %}btn--navy{% endif %}">{% render 'i18n-default', value: section.settings.cta_label, key: 'homepage.story.cta', default: 'Read our story' %}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_first", "label": "Image on left", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "script_line", "label": "Italic accent", "default": "Slow living, by the sea" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for homes that feel lived-in" },
    { "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>Casa Mare Crafts was created for homes that feel relaxed, warm, and personal. Each piece is inspired by coastal living, natural materials, and the quiet beauty of handmade details.</p><p>Our pieces are designed to make your home feel collected, sun-warmed, and lived-in — never overly polished, never mass-produced.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read our story" },
    { "type": "url",  "id": "cta_link",  "label": "Button link" },
    { "type": "checkbox", "id": "dark", "label": "Dark (navy) background", "default": false },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
