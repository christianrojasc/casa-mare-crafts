<section class="section newsletter">
  <div class="page-width">
    <header class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="t-eyebrow section-header__eyebrow newsletter__eyebrow">{% render 'i18n-default', value: section.settings.eyebrow, key: 'homepage.newsletter_section.eyebrow', default: 'Stay in touch' %}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="t-h2 newsletter__heading">{% render 'i18n-default', value: section.settings.heading, key: 'homepage.newsletter_section.heading', default: 'Studio notes & new arrivals' %}</h2>
      {%- endif -%}
      <p class="newsletter__text">
        {% render 'i18n-default', value: section.settings.body, key: 'homepage.newsletter_section.body', default: 'Early access to new coastal pieces, styling inspiration, and the occasional note from the studio.' %}
      </p>
    </header>

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" required placeholder="{{ section.settings.placeholder }}" aria-label="Email address">
      <button type="submit" class="btn">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">Thank you — keep an eye on your inbox.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Studio notes & new arrivals" },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "Early access to new coastal pieces, styling inspiration, and the occasional note from the studio." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
