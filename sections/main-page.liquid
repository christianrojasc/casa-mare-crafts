<section class="section">
  <div class="page-width" style="max-width: 820px;">
    <header style="text-align: center; margin-bottom: 40px;">
      <div class="t-eyebrow">{{ page.template_suffix | default: 'Page' | capitalize }}</div>
      <h1 class="t-h1" style="margin-top: 8px;">{{ page.title }}</h1>
      <div class="wave-divider" aria-hidden="true">
        <svg viewBox="0 0 64 14" preserveAspectRatio="none"><path d="M0 7 C 10 0, 22 14, 32 7 S 54 0, 64 7"/></svg>
      </div>
    </header>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{ "name": "Page" }
{% endschema %}
