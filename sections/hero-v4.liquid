<section class="hero-alt hero-v4">
  {%- if section.settings.stamp_heading != blank -%}
    <div class="hero-v4__stamp" aria-hidden="true">
      <span>
        <strong>{% render 'i18n-default', value: section.settings.stamp_heading, key: 'homepage.hero_v4.stamp_heading', default: 'Casa Mare' %}</strong>
        {% render 'i18n-default', value: section.settings.stamp_text, key: 'homepage.hero_v4.stamp_text', default: 'Handmade coastal goods' %}
      </span>
    </div>
  {%- endif -%}

  <div class="hero-alt__inner hero-v4__inner">
    <div class="hero-v4__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="t-eyebrow hero-alt__eyebrow">{% render 'i18n-default', value: section.settings.eyebrow, key: 'homepage.hero_v4.eyebrow', default: 'Soft neutrals, made by hand' %}</div>
      {%- endif -%}
      {%- if section.settings.script_line != blank -%}
        <div class="hero-alt__script">{% render 'i18n-default', value: section.settings.script_line, key: 'homepage.hero_v4.script', default: 'For rooms that feel sun-warmed' %}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-alt__title">{% render 'i18n-default', value: section.settings.heading, key: 'homepage.hero_v4.heading', default: 'Coastal craft for homes with warmth, texture, and soul.' %}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero-alt__text t-muted">{% render 'i18n-default', value: section.settings.subheading, key: 'homepage.hero_v4.subheading', default: 'Discover artisan-made decor inspired by linen curtains, sea breeze, driftwood, ceramics, and collected beach-house corners.' %}</p>
      {%- endif -%}

      <div class="hero-alt__actions">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--navy">{% render 'i18n-default', value: section.settings.cta_label, key: 'homepage.hero_v4.cta_primary', default: 'Shop the collection' %}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}" class="btn btn--outline">{% render 'i18n-default', value: section.settings.cta2_label, key: 'homepage.hero_v4.cta_secondary', default: 'Explore the casa edit' %}</a>
        {%- endif -%}
      </div>

      <div class="hero-alt__deck" aria-label="Brand details">
        <span>{% render 'i18n-default', value: section.settings.detail_one, key: 'homepage.hero_v4.detail_one', default: 'Linen-soft palette' %}</span>
        <span>{% render 'i18n-default', value: section.settings.detail_two, key: 'homepage.hero_v4.detail_two', default: 'Collected corners' %}</span>
        <span>{% render 'i18n-default', value: section.settings.detail_three, key: 'homepage.hero_v4.detail_three', default: 'By-the-sea calm' %}</span>
      </div>
    </div>

    <div class="hero-v4__gallery">
      <div class="hero-v4__image hero-v4__image--offset">
        {%- if section.settings.image_left != blank -%}
          <img src="{{ section.settings.image_left | image_url: width: 900 }}"
               alt="{{ section.settings.image_left.alt | default: section.settings.script_line | escape }}"
               loading="lazy"
               width="{{ section.settings.image_left.width }}"
               height="{{ section.settings.image_left.height }}"
               class="media-cover">
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="hero-v4__image hero-v4__image--center">
        {%- if section.settings.image_center != blank -%}
          <img src="{{ section.settings.image_center | image_url: width: 1600 }}"
               srcset="{{ section.settings.image_center | image_url: width: 900 }} 900w, {{ section.settings.image_center | image_url: width: 1300 }} 1300w, {{ section.settings.image_center | image_url: width: 1800 }} 1800w"
               sizes="(min-width: 900px) 52vw, 100vw"
               alt="{{ section.settings.image_center.alt | default: section.settings.heading | escape }}"
               loading="eager"
               width="{{ section.settings.image_center.width }}"
               height="{{ section.settings.image_center.height }}"
               class="media-cover">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="hero-v4__image">
        {%- if section.settings.image_right != blank -%}
          <img src="{{ section.settings.image_right | image_url: width: 900 }}"
               alt="{{ section.settings.image_right.alt | default: section.settings.script_line | escape }}"
               loading="lazy"
               width="{{ section.settings.image_right.width }}"
               height="{{ section.settings.image_right.height }}"
               class="media-cover">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.footer_left_title != blank or section.settings.footer_right_title != blank -%}
      <div class="hero-v4__footer">
        <p>
          <strong>{% render 'i18n-default', value: section.settings.footer_left_title, key: 'homepage.hero_v4.footer_left_title', default: 'Natural textures' %}</strong>
          {% render 'i18n-default', value: section.settings.footer_left_text, key: 'homepage.hero_v4.footer_left_text', default: 'Woven, ceramic, linen, and driftwood-inspired details for layered beach-house rooms.' %}
        </p>
        <p>
          <strong>{% render 'i18n-default', value: section.settings.footer_right_title, key: 'homepage.hero_v4.footer_right_title', default: 'Quiet coastal color' %}</strong>
          {% render 'i18n-default', value: section.settings.footer_right_text, key: 'homepage.hero_v4.footer_right_text', default: 'Deep navy contrast, sand beige warmth, and soft sea-glass accents.' %}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero v4 - gallery led",
  "settings": [
    { "type": "image_picker", "id": "image_left", "label": "Left image" },
    { "type": "image_picker", "id": "image_center", "label": "Center image" },
    { "type": "image_picker", "id": "image_right", "label": "Right image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft neutrals, made by hand" },
    { "type": "text", "id": "script_line", "label": "Italic accent line", "default": "For rooms that feel sun-warmed" },
    { "type": "text", "id": "heading", "label": "Main heading", "default": "Coastal craft for homes with warmth, texture, and soul." },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Discover artisan-made decor inspired by linen curtains, sea breeze, driftwood, ceramics, and collected beach-house corners." },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop the collection" },
    { "type": "url",  "id": "cta_link",  "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Explore the casa edit" },
    { "type": "url",  "id": "cta2_link",  "label": "Secondary button link" },
    { "type": "text", "id": "detail_one", "label": "Detail label 1", "default": "Linen-soft palette" },
    { "type": "text", "id": "detail_two", "label": "Detail label 2", "default": "Collected corners" },
    { "type": "text", "id": "detail_three", "label": "Detail label 3", "default": "By-the-sea calm" },
    { "type": "text", "id": "stamp_heading", "label": "Stamp heading", "default": "Casa Mare" },
    { "type": "text", "id": "stamp_text", "label": "Stamp text", "default": "Handmade coastal goods" },
    { "type": "text", "id": "footer_left_title", "label": "Footer left title", "default": "Natural textures" },
    { "type": "textarea", "id": "footer_left_text", "label": "Footer left text", "default": "Woven, ceramic, linen, and driftwood-inspired details for layered beach-house rooms." },
    { "type": "text", "id": "footer_right_title", "label": "Footer right title", "default": "Quiet coastal color" },
    { "type": "textarea", "id": "footer_right_text", "label": "Footer right text", "default": "Deep navy contrast, sand beige warmth, and soft sea-glass accents." }
  ],
  "presets": [{ "name": "Hero v4 - gallery led" }]
}
{% endschema %}
