<header class="site-header" role="banner">
  <div class="page-width site-header__inner">

    <button class="icon-btn nav-toggle" type="button" data-nav-toggle aria-controls="SiteNav" aria-expanded="false" aria-label="{{ 'general.accessibility.open_menu' | t }}">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </button>

    <nav id="SiteNav" class="site-header__nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
        <img
          src="{{ settings.logo | image_url: width: 480 }}"
          srcset="{{ settings.logo | image_url: width: 240 }} 240w, {{ settings.logo | image_url: width: 480 }} 480w, {{ settings.logo | image_url: width: 720 }} 720w"
          sizes="{{ settings.logo_width }}px"
          alt="{{ logo_alt }}"
          width="{{ settings.logo_width }}"
          height="{{ logo_height }}"
          loading="eager"
        >
      {%- else -%}
        <img src="{{ 'logo-primary.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width }}" loading="eager">
      {%- endif -%}
    </a>

    <div class="site-header__utilities">
      {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'locale-form' -%}
          <label class="visually-hidden" for="LocaleSelect">{{ 'general.accessibility.language' | t }}</label>
          <select id="LocaleSelect" name="locale_code" class="locale-select" onchange="this.form.submit()" aria-label="{{ 'general.accessibility.language' | t }}">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="{{ 'general.accessibility.search' | t }}">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.4"/>
          <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </a>
      <a class="icon-btn" href="{{ routes.account_url }}" aria-label="{{ 'general.accessibility.account' | t }}">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="7" r="3.25" stroke="currentColor" stroke-width="1.4"/>
          <path d="M3.5 17c1.2-3.2 3.8-4.5 6.5-4.5s5.3 1.3 6.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="{{ 'general.accessibility.cart' | t }}">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h2l1.4 8.1a2 2 0 0 0 2 1.7h6.4a2 2 0 0 0 2-1.6L17.2 8H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="8" cy="17.5" r="1.1" fill="currentColor"/>
          <circle cx="14.5" cy="17.5" r="1.1" fill="currentColor"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count" aria-label="{{ 'general.cart.view' | t: count: cart.item_count }}">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Primary menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_locale_selector", "label": "Show language selector", "default": true, "info": "Appears only when more than one language is published in Settings → Languages." }
  ]
}
{% endschema %}
