<section class="hero{% if section.settings.dark %} hero--dark{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media" aria-hidden="true">
      <img src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 2000 }} 2000w, {{ section.settings.image | image_url: width: 2800 }} 2800w"
           sizes="100vw" alt="" loading="eager"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__inner">
    {%- if section.settings.script_line != blank -%}
      <div class="hero__script">{% render 'i18n-default', value: section.settings.script_line, key: 'homepage.hero.script', default: 'By the sea' %}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{% render 'i18n-default', value: section.settings.heading, key: 'homepage.hero.heading', default: 'Handmade coastal pieces for warm, lived-in beach homes.' %}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__sub">{% render 'i18n-default', value: section.settings.subheading, key: 'homepage.hero.subheading', default: 'Bring texture, warmth, and natural beauty into your space with artisan coastal decor inspired by life by the sea.' %}</p>
    {%- endif -%}
    <div class="hero__ctas">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--navy">{% render 'i18n-default', value: section.settings.cta_label, key: 'homepage.hero.cta_primary', default: 'Shop the collection' %}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}" class="btn {% if section.settings.dark %}btn--outline-light{% else %}btn--outline{% endif %}">{% render 'i18n-default', value: section.settings.cta2_label, key: 'homepage.hero.cta_secondary', default: 'Explore handmade pieces' %}</a>
      {%- endif -%}
    </div>
    <div class="wave-divider" aria-hidden="true">
      <svg viewBox="0 0 64 14" preserveAspectRatio="none"><path d="M0 7 C 10 0, 22 14, 32 7 S 54 0, 64 7"/></svg>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "text", "id": "script_line", "label": "Italic accent line", "default": "By the sea" },
    { "type": "text", "id": "heading", "label": "Main heading", "default": "Handmade coastal pieces for warm, lived-in beach homes." },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Bring texture, warmth, and natural beauty into your space with artisan coastal decor inspired by life by the sea." },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop the collection" },
    { "type": "url",  "id": "cta_link",  "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Explore handmade pieces" },
    { "type": "url",  "id": "cta2_link",  "label": "Secondary button link" },
    { "type": "checkbox", "id": "dark", "label": "Dark (navy) hero", "default": false }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
