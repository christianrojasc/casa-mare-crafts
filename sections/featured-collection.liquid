{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}

<section class="section{% if section.settings.dark %} section--dark{% elsif section.settings.sand %} section--sand{% endif %}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <div class="t-eyebrow text-center" style="margin-bottom: 14px;">{% render 'i18n-default', value: section.settings.eyebrow, key: 'homepage.featured.eyebrow', default: 'New arrivals' %}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="t-h2 text-center">{% render 'i18n-default', value: section.settings.heading, key: 'homepage.featured.heading', default: 'Artisan-made pieces from the studio' %}</h2>
    {%- endif -%}
    <div class="wave-divider" aria-hidden="true">
      <svg viewBox="0 0 64 14" preserveAspectRatio="none"><path d="M0 7 C 10 0, 22 14, 32 7 S 54 0, 64 7"/></svg>
    </div>
    {%- if section.settings.description != blank -%}
      <p class="text-center t-muted" style="max-width: 560px; margin: 0 auto 44px;">{% render 'i18n-default', value: section.settings.description, key: 'homepage.featured.description', default: 'Handmade with natural texture and coastal warmth — designed to bring a soft, organic touch to your home.' %}</p>
    {%- endif -%}

    <div class="grid grid--3" style="margin-top: 40px;">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {% render 'product-card' %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection -%}
      <div class="text-center" style="margin-top: 56px;">
        <a href="{{ collection.url }}" class="btn {% if section.settings.dark %}btn--outline-light{% else %}btn--outline{% endif %}">{{ 'homepage.featured.cta' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Artisan-made pieces from the studio" },
    { "type": "textarea", "id": "description", "label": "Description",
      "default": "Handmade with natural texture and coastal warmth — designed to bring a soft, organic touch to your home." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all button", "default": true },
    { "type": "checkbox", "id": "dark", "label": "Dark (navy) background", "default": false },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
