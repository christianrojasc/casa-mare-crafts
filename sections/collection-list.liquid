<section class="section{% if section.settings.dark %} section--dark{% elsif section.settings.sand %} section--sand{% endif %}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <div class="t-eyebrow text-center" style="margin-bottom: 14px;">{% render 'i18n-default', value: section.settings.eyebrow, key: 'homepage.collection_list.eyebrow', default: 'Shop by collection' %}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="t-h2 text-center">{% render 'i18n-default', value: section.settings.heading, key: 'homepage.collection_list.heading', default: 'Thoughtfully made for the beach home' %}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="text-center t-muted" style="max-width: 560px; margin: 18px auto 0;">{% render 'i18n-default', value: section.settings.subheading, key: 'homepage.collection_list.subheading', default: 'Handmade coastal pieces organized by mood, texture, and moment — each one made to bring warmth to your space.' %}</p>
    {%- endif -%}
    <div class="grid grid--3" style="margin-top: 48px;">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        <a href="{{ col.url | default: '#' }}" {{ block.shopify_attributes }} style="display: block; position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 2px;">
          {%- if col.featured_image -%}
            <img src="{{ col.featured_image | image_url: width: 900 }}" alt="{{ col.title | escape }}" loading="lazy" width="{{ col.featured_image.width }}" height="{{ col.featured_image.height }}" style="width: 100%; height: 100%; object-fit: cover;">
          {%- elsif block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | default: col.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" style="width: 100%; height: 100%; object-fit: cover;">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(16,42,67,0.7), rgba(16,42,67,0.05) 60%); display: flex; align-items: flex-end; padding: 28px;">
            <div style="color: var(--color-washed-white);">
              {%- if block.settings.script != blank -%}
                <div style="font-family: var(--font-heading); font-style: italic; font-size: 1.3rem; color: var(--color-sand); line-height: 1; margin-bottom: 6px;">{{ block.settings.script }}</div>
              {%- endif -%}
              <div class="t-h3" style="color: var(--color-washed-white); margin-top: 4px;">{{ block.settings.title | default: col.title }}</div>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtfully made for the beach home" },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Handmade coastal pieces organized by mood, texture, and moment — each one made to bring warmth to your space." },
    { "type": "checkbox", "id": "dark", "label": "Dark (navy) background", "default": false },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "script", "label": "Italic overlay" },
        { "type": "text", "id": "title", "label": "Display title" },
        { "type": "image_picker", "id": "image", "label": "Override image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection", "settings": { "script": "Driftwood", "title": "Wall & Shelf Styling" } },
        { "type": "collection", "settings": { "script": "Sea glass", "title": "Tabletop Pieces" } },
        { "type": "collection", "settings": { "script": "Sand & linen", "title": "Coastal Accents" } }
      ]
    }
  ]
}
{% endschema %}
