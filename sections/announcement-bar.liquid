{%- if section.settings.show_bar -%}
<div class="announcement" role="region" aria-label="Announcements">
  <div class="page-width">
    <span>{% render 'i18n-default', value: section.settings.message, key: 'homepage.announcement.message', default: 'Handmade coastal pieces — complimentary shipping on orders over $150' %}</span>
    {%- if section.settings.link != blank and section.settings.link_label != blank -%}
      &nbsp;&middot;&nbsp;<a href="{{ section.settings.link }}">{% render 'i18n-default', value: section.settings.link_label, key: 'homepage.announcement.link_label', default: 'Shop the collection' %}</a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show announcement bar", "default": true },
    { "type": "text",     "id": "message",  "label": "Message", "default": "Handmade coastal pieces — complimentary shipping on orders over $150" },
    { "type": "url",      "id": "link",     "label": "Optional link" },
    { "type": "text",     "id": "link_label", "label": "Link label", "default": "Shop the collection" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
