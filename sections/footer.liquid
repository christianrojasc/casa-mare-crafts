<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="site-footer__grid">

      <div class="site-footer__brand">
        <div class="stamp">
          <img src="{{ 'logo-stamp.png' | asset_url }}" alt="{{ shop.name | escape }} — Handmade coastal goods" width="160" height="160">
        </div>
        <p class="site-footer__blurb">{% render 'i18n-default', value: section.settings.brand_blurb, key: 'homepage.footer.brand_blurb', default: 'Handmade coastal pieces for warm, lived-in beach homes. Natural textures, soft neutrals, and thoughtfully made details.' %}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <div class="site-footer__heading">{{ block.settings.heading }}</div>
              <ul class="stack">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <div class="site-footer__heading">{{ block.settings.heading }}</div>
              <div style="font-size: 0.94rem; line-height: 1.75; color: var(--color-sand);">
                {{ block.settings.body }}
              </div>
            </div>
          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <div class="site-footer__heading">{{ block.settings.heading }}</div>
              <p style="color: var(--color-sand); font-size: 0.94rem; line-height: 1.65;">{{ block.settings.body }}</p>
              {%- form 'customer', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div style="display: flex; gap: 8px; margin-top: 14px;">
                  <input type="email" name="contact[email]" required placeholder="your@email.com" aria-label="Email" style="flex: 1; padding: 12px 14px; background: transparent; border: 1px solid rgba(247,243,236,0.3); color: var(--color-washed-white); border-radius: 2px; font: inherit;">
                  <button type="submit" class="btn" style="background: var(--color-washed-white); color: var(--color-navy); border-color: var(--color-washed-white);">Join</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p style="margin-top: 10px; color: var(--color-sand); font-size: 0.82rem;">Thank you — check your inbox.</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}

    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {% render 'i18n-default', value: section.settings.copyright_suffix, key: 'homepage.footer.copyright_suffix', default: 'All rights reserved.' %}</span>
      <ul class="social-list" aria-label="Social">
        {%- if settings.social_instagram != blank -%}
          <li><a href="{{ settings.social_instagram }}" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="10" r="3.2" stroke="currentColor" stroke-width="1.4"/><circle cx="14.3" cy="5.7" r="0.9" fill="currentColor"/></svg></a></li>
        {%- endif -%}
        {%- if settings.social_pinterest != blank -%}
          <li><a href="{{ settings.social_pinterest }}" aria-label="Pinterest"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a8 8 0 0 0-2.9 15.5c-.1-.7-.2-1.7 0-2.5.2-.7 1.2-4.5 1.2-4.5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.2-.9 3.5-.2 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.2-4.3-4.2-2.9 0-4.7 2.2-4.7 4.5 0 .9.3 1.9.8 2.4l.2.3-.2.7c-.1.4-.3.4-.6.2-1-.4-1.6-1.9-1.6-3.1 0-2.5 1.8-4.9 5.3-4.9 2.8 0 5 2 5 4.7 0 2.8-1.8 5.1-4.2 5.1-.8 0-1.6-.4-1.8-.9l-.5 1.9c-.2.7-.7 1.6-1 2.2A8 8 0 1 0 10 2z"/></svg></a></li>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <li><a href="{{ settings.social_tiktok }}" aria-label="TikTok"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M12.5 2v9.6a2.4 2.4 0 1 1-2.4-2.4v-2A4.4 4.4 0 1 0 14.5 11.6V6.7a5 5 0 0 0 3 1V5.7a3 3 0 0 1-3-3h-2z"/></svg></a></li>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <li><a href="{{ settings.social_facebook }}" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M11.5 17v-6h2l.3-2.4h-2.3v-1.5c0-.7.2-1.2 1.2-1.2h1.2V3.6c-.2 0-1-.1-1.8-.1-1.8 0-3 1.1-3 3v1.7H7v2.4h2.1V17h2.4z"/></svg></a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "brand_blurb", "label": "Brand blurb",
      "default": "Handmade coastal pieces for warm, lived-in beach homes. Natural textures, soft neutrals, and thoughtfully made details." },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Studio" },
        { "type": "richtext", "id": "body", "label": "Body",
          "default": "<p>Each piece is made slowly, by hand, inspired by Mediterranean coastal living and the quiet beauty of homes by the sea.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in touch" },
        { "type": "text", "id": "body", "label": "Body", "default": "Early access to new coastal pieces and studio notes." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu",       "settings": { "heading": "Shop" } },
      { "type": "menu",       "settings": { "heading": "Studio" } },
      { "type": "newsletter", "settings": { "heading": "Stay in touch" } }
    ]
  }
}
{% endschema %}
