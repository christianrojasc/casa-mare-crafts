<section class="section">
  <div class="page-width">
    <header style="text-align: center; margin-bottom: 56px;">
      <div class="t-eyebrow">Explore</div>
      <h1 class="t-h1" style="margin-top: 8px;">All collections</h1>
      <div class="wave-divider" aria-hidden="true">
        <svg viewBox="0 0 64 14" preserveAspectRatio="none"><path d="M0 7 C 10 0, 22 14, 32 7 S 54 0, 64 7"/></svg>
      </div>
    </header>
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" style="display: block; position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 2px;">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}" style="width:100%; height:100%; object-fit:cover;">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div style="position:absolute; inset:0; background: linear-gradient(to top, rgba(16,42,67,0.7), transparent 60%); display:flex; align-items:flex-end; padding:28px;">
            <div class="t-h3" style="color: var(--color-washed-white);">{{ collection.title }}</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "List collections" }
{% endschema %}
