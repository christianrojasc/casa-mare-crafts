<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gift card · {{ shop.name }}</title>
  {{ content_for_header }}
  {%- liquid
    assign font_heading   = settings.font_heading
    assign font_heading_i = font_heading | font_modify: 'style', 'italic'
    assign font_body      = settings.font_body
  -%}
  <style>
    {{ font_heading   | font_face: font_display: 'swap' }}
    {{ font_heading_i | font_face: font_display: 'swap' }}
    {{ font_body      | font_face: font_display: 'swap' }}
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body style="background: var(--color-bg); margin: 0; padding: 64px 24px;">
  <div style="max-width: 540px; margin: 0 auto; text-align: center;">
    <img src="{{ 'logo-stamp.png' | asset_url }}" alt="{{ shop.name }}" width="120" height="120" style="margin: 0 auto 20px;">
    <div class="t-eyebrow" style="margin-top: 12px;">Gift card</div>
    <h1 class="t-h1" style="margin-top: 10px;">{{ gift_card.balance | money_without_trailing_zeros }}</h1>
    <p class="t-muted">Initial value: {{ gift_card.initial_value | money_without_trailing_zeros }}</p>
    <div style="margin-top: 36px; padding: 36px; background: var(--color-sand); border-radius: 2px;">
      <div class="t-eyebrow">Code</div>
      <div style="font-family: monospace; font-size: 1.2rem; letter-spacing: 0.14em; margin-top: 10px; color: var(--color-navy);">{{ gift_card.code | format_code }}</div>
    </div>
    {%- if gift_card.expired -%}
      <p style="color: var(--color-clay); margin-top: 18px;">Expired {{ gift_card.expires_on | date: '%b %d, %Y' }}</p>
    {%- endif -%}
  </div>
</body>
</html>
