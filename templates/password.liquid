<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {%- liquid
    assign font_heading   = settings.font_heading
    assign font_heading_i = font_heading | font_modify: 'style', 'italic'
    assign font_body      = settings.font_body
  -%}
  <style>
    {{ font_heading   | font_face: font_display: 'swap' }}
    {{ font_heading_i | font_face: font_display: 'swap' }}
    {{ font_body      | font_face: font_display: 'swap' }}
    body { margin: 0; font-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }}; background: {{ settings.color_washed_white }}; color: {{ settings.color_text }}; min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 40px; }
    .wrap { max-width: 560px; }
    .logo { width: 140px; height: auto; margin: 0 auto 24px; display: block; }
    .script { font-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }}; font-style: italic; color: {{ settings.color_sea_glass }}; font-size: 1.4rem; margin-bottom: 10px; letter-spacing: 0.04em; }
    h1 { font-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }}; font-weight: 500; color: {{ settings.color_navy }}; font-size: 2.4rem; line-height: 1.15; margin: 0 0 16px; }
    p { color: {{ settings.color_driftwood }}; line-height: 1.7; }
    form { margin-top: 32px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    input[type=password] { flex: 1; min-width: 220px; padding: 14px 16px; background: #fff; border: 1px solid {{ settings.color_border }}; color: {{ settings.color_text }}; border-radius: 2px; font: inherit; }
    button { padding: 14px 28px; background: {{ settings.color_navy }}; color: {{ settings.color_washed_white }}; border: 0; border-radius: 2px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.24em; font-size: 0.78rem; cursor: pointer; font-family: inherit; }
    .err { color: {{ settings.color_clay }}; margin-top: 14px; width: 100%; }
  </style>
</head>
<body>
  <div class="wrap">
    <img class="logo" src="{{ 'logo-stamp.png' | asset_url }}" alt="{{ shop.name }}" width="140" height="140">
    <div class="script">{{ 'password.script' | t }}</div>
    <h1>{{ 'password.title' | t }}</h1>
    <p>{{ 'password.body' | t }}</p>
    {%- form 'storefront_password' -%}
      <input type="password" name="password" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}">
      <button type="submit">{{ 'password.submit' | t }}</button>
      {%- if form.errors -%}
        <div class="err">{{ form.errors.translated_messages['form'] }}</div>
      {%- endif -%}
    {%- endform -%}
  </div>
</body>
</html>
